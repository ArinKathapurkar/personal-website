---
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource-variable/inter-tight';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import Cursor from '../components/Cursor.astro';
import Particles from '../components/Particles.astro';
import { site } from '../config/site';

interface Props {
  title?: string;
  description?: string;
}

const fullName = `${site.name.first} ${site.name.last}`;
const { title = fullName, description = site.intro } = Astro.props;
const pageTitle = title === fullName ? fullName : `${title} — ${fullName}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${fullName}: ${site.tagline.replace(/\*/g, '')}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#07080a" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      // Runs before paint: js flag, and whether the intro should play.
      // It plays on every fresh load or refresh, but not when arriving from another page of this site.
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        var internal = false;
        try {
          internal = !!document.referrer && new URL(document.referrer).origin === location.origin;
        } catch (e) {}
        var reload = false;
        try {
          var nav = performance.getEntriesByType('navigation')[0];
          reload = !!nav && nav.type === 'reload';
        } catch (e) {}
        if ((internal && !reload) || matchMedia('(prefers-reduced-motion: reduce)').matches) d.dataset.intro = 'skip';
      })();
    </script>
  </head>
  <body>
    <Particles />
    <slot name="intro" />
    <a class="skip-link mono" href="#main">Skip to content</a>
    <slot />
    <div class="grain" aria-hidden="true"></div>
    <Cursor />
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: fixed;
    top: 8px;
    left: 8px;
    z-index: 200;
    padding: 8px 12px;
    background: var(--fg);
    color: var(--bg);
    transform: translateY(-200%);
  }
  .skip-link:focus-visible {
    transform: none;
  }
</style>
