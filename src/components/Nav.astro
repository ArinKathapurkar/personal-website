---
import { site } from '../config/site';
const path = Astro.url.pathname;
const links = [
  { n: '01', label: 'Work', href: '/work/' },
  { n: '02', label: site.personal.label, href: site.personal.href },
];
const active = (href: string) => path.replace(/\/$/, '').startsWith(href.replace(/\/$/, ''));
---

<header class="nav">
  <div class="wrap nav-inner">
    <a class="brand mono" href="/" aria-label="Home">
      <span class="brand-name">{site.name.first} {site.name.last}</span>
    </a>
    <nav aria-label="Primary">
      <ul class="links mono">
        {links.map((l) => (
          <li>
            <a href={l.href} aria-current={active(l.href) ? 'page' : undefined}><span class="faint">{l.n}</span> <span class="u-link">{l.label}</span></a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="meta mono">
      <span class="clock"><span class="faint">{site.location.split(',')[0]}</span> <span data-clock>--:--:--</span></span>
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    height: var(--nav-h);
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(10px) saturate(1.2);
    -webkit-backdrop-filter: blur(10px) saturate(1.2);
    border-bottom: 1px solid var(--rule);
  }
  .nav-inner {
    height: 100%;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    justify-self: start;
  }
  .links {
    display: flex;
    gap: clamp(16px, 3vw, 40px);
  }
  .links [aria-current='page'] .u-link {
    background-size: 100% 1px;
  }
  .links [aria-current='page'] .faint {
    color: var(--accent-text);
  }
  .meta {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .clock {
    font-variant-numeric: tabular-nums;
  }
  @media (max-width: 900px) {
    .clock {
      display: none;
    }
  }
  @media (max-width: 520px) {
    .nav-inner {
      grid-template-columns: auto 1fr auto;
    }
    .links {
      justify-content: center;
      gap: 14px;
    }
    .links .faint {
      display: none;
    }
  }
</style>
