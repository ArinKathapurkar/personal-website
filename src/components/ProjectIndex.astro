---
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const pad = (n: number) => String(n).padStart(2, '0');
---

<section class="work" id="work" aria-labelledby="work-title">
  <div class="wrap">
    <div class="section-head mono" data-fade>
      <span class="num">01</span><span>Selected work</span><span class="spacer"></span>
      <span class="faint">{pad(projects.length)} entries</span>
    </div>
    <h2 class="section-title" id="work-title" data-reveal>
      <span class="line-mask"><span style="--i:0">Things I've</span></span>
      <span class="line-mask"><span style="--i:1"><em>built</em> &amp; measured.</span></span>
    </h2>

    <ol class="rows">
      {projects.map((p, i) => (
        <li data-fade style={`--i:${i}`}>
          <a class="row" href={`/work/${p.id}/`} data-cursor="View" data-preview={p.data.image} data-preview-alt={p.data.imageAlt}>
            <span class="idx mono">[{pad(p.data.order)}]</span>
            <span class="title serif">{p.data.title}</span>
            <span class="desc">
              <span class="summary muted">{p.data.summary}</span>
              <span class="tags mono">{p.data.tags.map((t) => <span>{t}</span>)}</span>
            </span>
            <span class="year mono faint">{p.data.year}</span>
            <span class="go mono" aria-hidden="true"><span class="arrow">↗</span></span>
            {p.data.image && <img class="thumb" src={p.data.image} alt="" loading="lazy" width="800" height="600" />}
          </a>
        </li>
      ))}
    </ol>
  </div>

  <div class="preview" aria-hidden="true">
    <div class="preview-inner">
      {projects.map((p) => p.data.image && <img src={p.data.image} alt="" data-src={p.data.image} width="800" height="600" loading="lazy" />)}
    </div>
  </div>
</section>

<style>
  .work {
    padding-block: clamp(48px, 7vw, 100px) clamp(60px, 8vw, 120px);
  }
  .section-title {
    margin: clamp(28px, 4vw, 56px) 0 clamp(40px, 6vw, 88px);
  }
  .rows {
    border-top: 1px solid var(--rule-strong);
  }
  .rows li {
    border-bottom: 1px solid var(--rule-strong);
  }
  .row {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(12px, 1.6vw, 24px);
    align-items: baseline;
    padding-block: clamp(22px, 2.6vw, 36px);
  }
  .idx {
    grid-column: 1 / 2;
    transition: color 0.3s;
  }
  .title {
    grid-column: 2 / 7;
    font-size: clamp(34px, 4.4vw, 68px);
    line-height: 0.98;
    letter-spacing: -0.025em;
    transition: transform 0.6s var(--ease-out);
  }
  .desc {
    grid-column: 7 / 11;
    display: grid;
    gap: 12px;
    font-size: 14px;
    line-height: 1.5;
    max-width: 44ch;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    color: var(--fg-2);
  }
  .tags span::before {
    content: '/ ';
    color: var(--fg-3);
  }
  .year {
    grid-column: 11 / 12;
    justify-self: end;
  }
  .go {
    grid-column: 12 / 13;
    justify-self: end;
    font-size: 16px;
  }
  .thumb {
    display: none;
  }

  @media (hover: hover) {
    .row:hover .idx,
    .row:focus-visible .idx {
      color: var(--accent);
    }
    .row:hover .title,
    .row:focus-visible .title {
      transform: translateX(clamp(8px, 1.2vw, 18px));
      font-style: italic;
    }
  }

  /* Floating preview that trails the cursor (desktop only) */
  .preview {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 60;
    width: clamp(220px, 19vw, 300px);
    aspect-ratio: 4 / 3;
    pointer-events: none;
    visibility: hidden;
  }
  .preview-inner {
    position: absolute;
    inset: 0;
    overflow: hidden;
    clip-path: inset(100% 0% 0% 0%);
    transition: clip-path 0.55s var(--ease-out);
    box-shadow: 0 0 0 1px var(--rule-strong);
  }
  .preview.is-on .preview-inner {
    clip-path: inset(0% 0% 0% 0%);
  }
  .preview img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transform: scale(1.08);
    transition:
      opacity 0.35s,
      transform 0.8s var(--ease-out);
  }
  .preview img.is-active {
    opacity: 1;
    transform: none;
  }

  @media (max-width: 860px) {
    .idx {
      grid-column: 1 / 3;
    }
    .year {
      grid-column: 3 / 12;
      grid-row: 1;
      justify-self: start;
    }
    .go {
      grid-row: 1;
    }
    .title {
      grid-column: 1 / -1;
      margin-top: 10px;
    }
    .desc {
      grid-column: 1 / -1;
      margin-top: 16px;
      max-width: 60ch;
    }
    .thumb {
      display: block;
      grid-column: 1 / -1;
      margin-top: 20px;
      width: 100%;
      height: auto;
      border: 1px solid var(--rule-strong);
    }
    .preview {
      display: none;
    }
  }
</style>

<script>
  import gsap from 'gsap';
  import { hasFinePointer } from '../scripts/intro-state';

  const section = document.querySelector<HTMLElement>('.work')!;
  const preview = section.querySelector<HTMLElement>('.preview')!;
  const imgs = [...preview.querySelectorAll<HTMLImageElement>('img')];

  if (hasFinePointer() && window.matchMedia('(min-width: 861px)').matches) {
    gsap.set(preview, { xPercent: 0, yPercent: -100, visibility: 'visible' });
    const xTo = gsap.quickTo(preview, 'x', { duration: 0.7, ease: 'power3' });
    const yTo = gsap.quickTo(preview, 'y', { duration: 0.7, ease: 'power3' });
    const rTo = gsap.quickTo(preview, 'rotation', { duration: 0.9, ease: 'power3' });
    let lastX = 0;
    let placed = false;
    let current: HTMLElement | null = null;

    window.addEventListener(
      'pointermove',
      (e) => {
        if (!placed) {
          gsap.set(preview, { x: e.clientX, y: e.clientY });
          placed = true;
        }
        // x trails the cursor; the bottom edge sits on the hovered row's top rule,
        // so the preview never covers the title it belongs to.
        xTo(e.clientX + 28);
        yTo(current ? current.getBoundingClientRect().top - 10 : e.clientY - 28);
        rTo(gsap.utils.clamp(-4, 4, (e.clientX - lastX) * 0.25));
        lastX = e.clientX;
      },
      { passive: true },
    );

    section.querySelectorAll<HTMLAnchorElement>('.row').forEach((row) => {
      row.addEventListener('pointerenter', () => {
        const src = row.dataset.preview;
        if (!src) return;
        imgs.forEach((img) => img.classList.toggle('is-active', img.dataset.src === src));
        current = row;
        preview.classList.add('is-on');
      });
      row.addEventListener('pointerleave', () => {
        current = null;
        preview.classList.remove('is-on');
      });
    });
  }
</script>
