---
import { site } from '../config/site';
---

<div class="intro" role="status" aria-label="Loading">
  <div class="intro-row mono">
    <span>{site.name.first} {site.name.last}</span>
    <span class="faint">Portfolio / {new Date().getFullYear()}</span>
  </div>

  <div class="intro-stage">
    <div class="intro-frame" data-intro-frame>
      <canvas data-intro-canvas data-src={site.photos[0].src} width="120" height="150" aria-hidden="true"></canvas>
    </div>
    <p class="intro-readout mono" data-intro-readout>
      <span>Sampling</span><span class="faint">·</span><span>t = <b data-intro-t>1000</b></span><span class="faint">·</span><span class="faint">Step <b data-intro-step>00</b>/50</span>
    </p>
  </div>

  <div class="intro-row mono">
    <span class="faint">Denoising one portrait</span>
    <span class="faint skip-hint">Press any key to skip</span>
  </div>
</div>

<style>
  .intro {
    position: fixed;
    inset: 0;
    z-index: 250;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: var(--gutter);
    background: var(--black);
    color: var(--white);
    /* If the script never runs, get out of the way. */
    animation: intro-failsafe 0s linear 8s forwards;
  }
  :global(html:not(.js)) .intro,
  :global(html[data-intro='skip']) .intro {
    display: none;
  }
  @keyframes intro-failsafe {
    to {
      visibility: hidden;
    }
  }
  .intro-row {
    display: flex;
    justify-content: space-between;
    gap: 16px;
  }
  .intro-stage {
    display: grid;
    justify-items: center;
    gap: 16px;
  }
  .intro-frame {
    width: min(34vh, 62vw);
    aspect-ratio: 4 / 5;
    will-change: transform;
  }
  .intro-frame canvas {
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
  }
  .intro-readout {
    display: flex;
    gap: 10px;
    font-variant-numeric: tabular-nums;
  }
  .intro-readout b {
    font-weight: 400;
    display: inline-block;
    min-width: 4ch;
    text-align: left;
  }
  .intro-readout b[data-intro-step] {
    min-width: 2ch;
  }
  @media (hover: none) {
    .skip-hint {
      display: none;
    }
  }
</style>
