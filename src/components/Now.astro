---
import { getCollection } from 'astro:content';

const entries = (await getCollection('now')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: '2-digit', timeZone: 'UTC' }).toUpperCase();
const updated = entries[0]?.data.date;
---

<section class="now" id="now" aria-labelledby="now-title">
  <div class="wrap grid">
    <div class="section-head mono" data-fade>
      <span class="num">02</span><span>Now</span><span class="spacer"></span>
      {updated && <span class="faint">Updated {fmt(updated)}</span>}
    </div>

    <h2 class="section-title" id="now-title" data-reveal>
      <span class="line-mask"><span style="--i:0">Currently</span></span>
      <span class="line-mask"><span style="--i:1"><em>working on</em></span></span>
    </h2>

    <p class="lede muted" data-fade style="--i:2">
      A running log of what has my attention this month. It changes more often than the rest of this site.
    </p>

    <ol class="log">
      {entries.map((e, i) => (
        <li class="entry" data-fade style={`--i:${i}`}>
          <time class="mono faint" datetime={e.data.date.toISOString().slice(0, 10)}>{fmt(e.data.date)}</time>
          <span class={`status mono status-${e.data.status}`}><span class="pip" aria-hidden="true"></span>{e.data.status}</span>
          <div class="body">
            <h3 class="serif">
              {e.data.link ? <a class="u-link" href={e.data.link} target="_blank" rel="noopener noreferrer">{e.data.title}</a> : e.data.title}
            </h3>
            <p class="muted">{e.data.blurb}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .now {
    padding-block: clamp(60px, 8vw, 120px);
  }
  .section-head {
    grid-column: 1 / -1;
  }
  .section-title {
    grid-column: 1 / 8;
    margin-top: clamp(28px, 4vw, 56px);
  }
  .lede {
    grid-column: 9 / 13;
    align-self: end;
    max-width: 34ch;
    font-size: 15px;
  }
  .log {
    grid-column: 1 / -1;
    margin-top: clamp(40px, 6vw, 88px);
    border-top: 1px solid var(--rule-strong);
  }
  .entry {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(12px, 1.6vw, 24px);
    align-items: baseline;
    padding-block: 24px;
    border-bottom: 1px solid var(--rule);
  }
  time {
    grid-column: 1 / 3;
    font-variant-numeric: tabular-nums;
  }
  .status {
    grid-column: 3 / 5;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .pip {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    border: 1px solid currentColor;
  }
  .status-building {
    color: var(--accent-text);
  }
  .status-building .pip {
    background: var(--accent);
    border-color: var(--accent);
    animation: pulse 2s ease-in-out infinite;
  }
  .status-reading .pip {
    background: currentColor;
  }
  @keyframes pulse {
    50% {
      box-shadow: 0 0 0 5px color-mix(in srgb, var(--accent) 18%, transparent);
    }
  }
  .body {
    grid-column: 5 / 13;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: 8px 32px;
    align-items: baseline;
  }
  h3 {
    font-size: clamp(24px, 2.2vw, 32px);
    line-height: 1.1;
    font-weight: 400;
    letter-spacing: -0.01em;
  }
  .body p {
    font-size: 14px;
  }

  @media (max-width: 860px) {
    .section-title,
    .lede {
      grid-column: 1 / -1;
    }
    .lede {
      margin-top: 20px;
    }
    time {
      grid-column: 1 / 7;
    }
    .status {
      grid-column: 7 / 13;
      justify-self: end;
    }
    .body {
      grid-column: 1 / -1;
      grid-template-columns: 1fr;
      margin-top: 12px;
    }
  }
</style>
